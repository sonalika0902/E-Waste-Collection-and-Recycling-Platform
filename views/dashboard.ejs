
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User Dashboard | EcoRecycle</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <!-- Dashboard Welcome Section -->
    <section class="dashboard-section">
        <div class="container">

            <div class="mb-5">
                <h1 class="fw-bold text-success">
                    Welcome to Your Dashboard!
                </h1>

                <p class="text-muted">
                    Manage your e-waste recycling activities in one place.
                </p>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-4 mb-5">

                <div class="col-md-6 col-lg-3">
                    <div class="card dashboard-card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-truck display-5 text-success"></i>
                            <h3 class="fw-bold mt-3">5</h3>
                            <p class="text-muted mb-0">Pickup Requests</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card dashboard-card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-recycle display-5 text-success"></i>
                            <h3 class="fw-bold mt-3">120 kg</h3>
                            <p class="text-muted mb-0">E-Waste Recycled</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card dashboard-card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-star display-5 text-warning"></i>
                            <h3 class="fw-bold mt-3">250</h3>
                            <p class="text-muted mb-0">Reward Points</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="card dashboard-card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-person-check display-5 text-success"></i>
                            <h3 class="fw-bold mt-3">Active</h3>
                            <p class="text-muted mb-0">Account Status</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Quick Actions -->
            <div class="mb-4">
                <h2 class="fw-bold mb-4">Quick Actions</h2>

                <div class="row g-4">

                    <!-- Request Pickup -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body p-4 text-center">
                                <i class="bi bi-truck display-4 text-success"></i>

                                <h4 class="fw-bold mt-3">
                                    Request Pickup
                                </h4>

                                <p class="text-muted">
                                    Schedule a collection for your electronic waste.
                                </p>

                                <a
                                    href="/pickup"
                                    class="btn btn-success w-100 p-3"
                                >
                                    <i class="bi bi-truck me-2"></i>
                                    Request Pickup
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Collection Centers -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body p-4 text-center">
                                <i class="bi bi-geo-alt display-4 text-success"></i>

                                <h4 class="fw-bold mt-3">
                                    Collection Centers
                                </h4>

                                <p class="text-muted">
                                    Explore available e-waste collection centers.
                                </p>

                                <a
                                    href="/centers"
                                    class="btn btn-outline-success w-100 p-3"
                                >
                                    <i class="bi bi-geo-alt me-2"></i>
                                    Find Centers
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Recycling Drives -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card dashboard-card h-100 shadow-sm">
                            <div class="card-body p-4 text-center">
                                <i class="bi bi-calendar-event display-4 text-success"></i>

                                <h4 class="fw-bold mt-3">
                                    Recycling Drives
                                </h4>

                                <p class="text-muted">
                                    Discover recycling events and community drives.
                                </p>

                                <a
                                    href="/drives"
                                    class="btn btn-outline-success w-100 p-3"
                                >
                                    <i class="bi bi-calendar-event me-2"></i>
                                    Explore Drives
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Recent Activity -->
            <div class="mt-5">
                <h2 class="fw-bold mb-4">Recent Activity</h2>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <div class="d-flex align-items-start mb-4">
                            <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>

                            <div>
                                <h6 class="fw-bold mb-1">
                                    Welcome to EcoRecycle
                                </h6>

                                <p class="text-muted mb-0">
                                    Start by requesting a pickup or finding a collection center.
                                </p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <i class="bi bi-recycle text-success fs-4 me-3"></i>

                            <div>
                                <h6 class="fw-bold mb-1">
                                    Recycle Responsibly
                                </h6>

                                <p class="text-muted mb-0">
                                    Help reduce electronic waste by choosing responsible recycling.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </section>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

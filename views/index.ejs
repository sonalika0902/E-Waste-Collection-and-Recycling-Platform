<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>E-Waste Recycling Platform</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>
    
    <%- include("partials/navbar") %>
    <section class="hero">

   <div class="container">

    <div class="row align-items-center">

    <div class="col-lg-6">
    <span class="badge bg-success mb-3 fs-6">
      ♻️ Sustainable Future
    </span>

    <h1 class="display-4 fw-bold text-success">

     Recycle Today,
     Protect Tomorrow

    </h1>

    <p class="lead my-4">

      Safely recycle old electronics, request doorstep pickup, locate nearby recycling centers, and contribute to a cleaner and greener future for everyone.

    </p>

    <a href="#" class="btn btn-success btn-lg me-3">

      Request Pickup

    </a>

    <a href="#" class="btn btn-outline-success btn-lg">

      Find Centers

    </a>
    
    <!-- Statistics Section -->

<div class="row text-center stats mt-5">

    <div class="col-md-4 mb-4">

        <h2 class="display-5 fw-bold text-success">250+</h2>

        <p class="fs-5">Collection Centers</p>

    </div>

    <div class="col-md-4 mb-4">

        <h2 class="display-5 fw-bold text-success">10K+</h2>

        <p class="fs-5">E-Waste Recycled</p>

    </div>

    <div class="col-md-4 mb-4">

        <h2 class="display-5 fw-bold text-success">5000+</h2>

        <p class="fs-5">Happy Users</p>

    </div>

</div>
    </div>

    <div class="col-lg-6 text-center">

    <img
     src="/images/hero.png"
     class="img-fluid hero-image"
     alt="Hero Image">

    </div>

    </div>

   </div>

   </section> 
    <!-- Why Recycle Section -->

<section class="py-5">

<div class="container">

<div class="text-center mb-5">

<h2 class="fw-bold text-success">

Why Recycle E-Waste?

</h2>

<p class="text-muted">

Every recycled electronic device helps create a cleaner and healthier planet.

</p>

</div>

<div class="row g-4">

<!-- Card 1 -->

<div class="col-md-4">

<div class="card h-100 shadow recycle-card">

<div class="card-body text-center">

<i class="bi bi-recycle display-3 text-success"></i>

<h4 class="mt-3">

Safe Disposal

</h4>

<p>

Dispose of electronic waste safely to prevent soil and water pollution caused by hazardous materials.

</p>

</div>

</div>

</div>

<!-- Card 2 -->

<div class="col-md-4">

<div class="card h-100 shadow recycle-card">

<div class="card-body text-center">

<i class="bi bi-tree-fill display-3 text-success"></i>

<h4 class="mt-3">

Protect Nature

</h4>

<p>

Reduce environmental pollution and conserve natural resources through responsible recycling.

</p>

</div>

</div>

</div>

<!-- Card 3 -->

<div class="col-md-4">

<div class="card h-100 shadow recycle-card">

<div class="card-body text-center">

<i class="bi bi-laptop display-3 text-success"></i>

<h4 class="mt-3">

Recover Resources

</h4>

<p>

Recover valuable metals such as copper, gold, and silver from discarded electronic devices.

</p>

</div>

</div>

</div>

</div>

</div>

</section>
    <!-- ================= HOW IT WORKS ================= -->

<section class="py-5 bg-white">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold text-success">
                How It Works
            </h2>

            <p class="text-muted">
                Recycling your electronic waste is simple and takes only four easy steps.
            </p>

        </div>

        <div class="row g-4">

            <!-- Step 1 -->

            <div class="col-md-3">

                <div class="card how-card shadow-sm h-100 text-center">

                    <div class="card-body">

                        <div class="step-circle">1</div>

                        <i class="bi bi-person-plus display-4 text-success"></i>

                        <h4 class="mt-3">Register</h4>

                        <p>
                            Create your account to start recycling electronic waste.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Step 2 -->

            <div class="col-md-3">

                <div class="card how-card shadow-sm h-100 text-center">

                    <div class="card-body">

                        <div class="step-circle">2</div>

                        <i class="bi bi-truck display-4 text-success"></i>

                        <h4 class="mt-3">Request Pickup</h4>

                        <p>
                            Schedule a pickup or choose your nearest collection center.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Step 3 -->

            <div class="col-md-3">

                <div class="card how-card shadow-sm h-100 text-center">

                    <div class="card-body">

                        <div class="step-circle">3</div>

                        <i class="bi bi-recycle display-4 text-success"></i>

                        <h4 class="mt-3">Recycle</h4>

                        <p>
                            Our certified recycling partners safely process your e-waste.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Step 4 -->

            <div class="col-md-3">

                <div class="card how-card shadow-sm h-100 text-center">

                    <div class="card-body">

                        <div class="step-circle">4</div>

                        <i class="bi bi-globe2 display-4 text-success"></i>

                        <h4 class="mt-3">Save Earth</h4>

                        <p>
                            Help reduce pollution and build a greener future for everyone.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
      <%- include("partials/footer") %>
      <!-- Bootstrap JS -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

      <!-- Custom JS -->
      <script src="/js/script.js"></script>

</body>

</html>